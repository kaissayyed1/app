@page "/payslip-upload"
@inject HttpClient Http
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms

<h3 class="mb-3">Payslip Upload</h3>

<div class="d-flex gap-3 mb-3">
    <InputFile OnChange="HandleFileChange" accept=".xlsx" class="form-control w-auto" />
    <button class="btn btn-primary">
        <a href="files/PaySlip_Template.xlsx" download="PaySlip_Template.xlsx" class="text-white text-decoration-none">
            Download Template
        </a>
    </button>
    <button @onclick="SaveData" disabled="@(payslipData.Count == 0)" class="btn btn-success">Save to Database</button>
    
</div>

@if (isError)
{
    <p class="text-danger">@errorMessage</p>
}



@if (payslipData.Count > 0)
{
    <div class="table-responsive mt-3">
        <table class="table table-bordered table-hover table-sm">
            <thead class="table-light text-center">
                <tr>
                    @foreach (var column in columnNames)
                    {
                        <th>@column</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in payslipData)
                {
                    <tr>
                        @foreach (var cell in row)
                        {
                            <td>@cell</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Dialog -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Data Exists</h5>
                    <button type="button" class="close" @onclick="CloseModal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Data already exists. Do you want to update it?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmUpdate">Update</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isError = false;
    private string errorMessage = string.Empty;
    private IBrowserFile? selectedFile;
    private bool isFileSelected = false;
    private List<string[]> payslipData = new();
    private List<string> columnNames = new();
    private byte[]? fileContent;
    private bool showModal = false;

    private readonly List<string> expectedColumns = new List<string>
{
    "Month", "Year", "Emp. Code", "Name of the Employee", "PAN", "Bank A/C No", "Designation",
    "CTC", "Earn Basic", "HRA", "Medical allowance", "Other Basic", "PF", "Prof. Tax",
    "ESIC", "TDS Ded.", "Total Ded.", "Difference", "Reimburshment", "Advance Payment",
    "Net Payable", "Yearly CTC", "Leave Year", "Leave from 1st January", "Jan", "Feb", "Mar",
    "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Balance Leaves"
};


    private bool ColumnsMatch(List<string> actualColumns, List<string> expectedColumns)
    {
        var actualSet = new HashSet<string>(actualColumns, StringComparer.OrdinalIgnoreCase);
        var expectedSet = new HashSet<string>(expectedColumns, StringComparer.OrdinalIgnoreCase);

        return actualSet.SetEquals(expectedSet);
    }



    private async Task HandleFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        if (selectedFile == null || !selectedFile.Name.EndsWith(".xlsx"))
        {
            isError = true;
            errorMessage = "Please upload a valid Excel file (.xlsx).";
            return;
        }
        isFileSelected = true;
        isError = false;

        // Read the file content
        using var stream = selectedFile.OpenReadStream();
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        fileContent = memoryStream.ToArray();

        // Automatically preview the data
        await PreviewData();
    }

    private async Task PreviewData()
    {
        try
        {
            if (fileContent == null) return;

            // Use JavaScript interop to read the Excel file
            var excelData = await JS.InvokeAsync<List<List<string>>>("excelInterop.readExcel", fileContent);

            if (excelData != null && excelData.Count > 0)
            {
                // Extract column names exactly as they appear in the file
                columnNames = excelData[0].Select(col => col.Trim()).ToList();

                // Check if the uploaded columns match exactly with expected columns
                if (!columnNames.SequenceEqual(expectedColumns))
                {
                    isError = true;
                    errorMessage = "Invalid file format. Column names do not match the required format.";
                    payslipData.Clear();
                    columnNames.Clear();
                    return;
                }

                // Check if the file is empty (only header row present)
                if (excelData.Count == 1)
                {
                    isError = true;
                    errorMessage = "The uploaded file is empty. Please provide data.";
                    payslipData.Clear();
                    columnNames.Clear();
                    return;
                }

                // Extract data while skipping the header row
                payslipData = excelData.Skip(1).Select(row => row.ToArray()).ToList();
                isError = false;
            }
            else
            {
                isError = true;
                errorMessage = "Error parsing Excel file data.";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            errorMessage = $"Error processing file: {ex.Message}";
        }
    }



    private async Task SaveData()
    {
        var response = await Http.PostAsJsonAsync("https://localhost:7263/api/payslip/save", payslipData);
        if (response.IsSuccessStatusCode)
        {
            payslipData.Clear();
            columnNames.Clear();
            isFileSelected = false;
            await JS.InvokeVoidAsync("alert", "Data saved successfully!");
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict) // Assuming 409 Conflict for existing data
        {
            showModal = true; // Show the modal dialog
        }
        else
        {
            isError = true;
            errorMessage = $"Failed to save data: {response.ReasonPhrase}";
        }
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task ConfirmUpdate()
    {
        showModal = false;
        var response = await Http.PostAsJsonAsync("https://localhost:7263/api/payslip/save?update=true", payslipData);
        if (response.IsSuccessStatusCode)
        {
            payslipData.Clear();
            columnNames.Clear();
            isFileSelected = false;
            await JS.InvokeVoidAsync("alert", "Data updated successfully!");
        }
        else
        {
            isError = true;
            errorMessage = $"Failed to update data: {response.ReasonPhrase}";
        }
    }
}

